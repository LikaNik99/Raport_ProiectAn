@model CreateCategoryViewModel

@{
    ViewData["Title"] = "Adaugare Categori";
}

<section class="vh-100">
    <div class="container py-5 h-100">
        <div class="col-md-8 mx-auto rounded border p-3">
            <h2 class="text-center mb-5">Categorie Noua</h2>

            <form method="post" enctype="multipart/form-data">
                <div class="row mb-3">
                    <label class="col-sm-4 col-form-label">Nume</label>
                    <div class="col-sm-8">
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>

                @if (TempData["Message"] != null)
                {
                    var alertType = TempData["AlertType"]?.ToString() ?? "info";
                    <div class="alert alert-@alertType alert-dismissible fade show" role="alert">
                        <strong>@TempData["Message"]</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                <div class="row">
                    <div class="offset-sm-4 col-sm-4 d-grid">
                        <button type="submit" class="btn btn-primary">Create</button>
                    </div>
                    <div class="col-sm-4 d-grid">
                        <a class="btn btn-outline-primary" asp-controller="Category" asp-action="Index" role="button">Cancel</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>
@using Core.DBModel
@model IEnumerable<EntityService>
@{

}

<div class="container py-4">
    <div class="row mb-5">
        <div class="col">
            <a class="btn btn-primary" asp-controller="Service" asp-action="Create">New Service</a>
        </div>
    </div>
    @if (TempData["Message"] != null)
    {
        var alertType = TempData["AlertType"]?.ToString() ?? "info";
        <div class="alert alert-@alertType alert-dismissible fade show" role="alert">
            <strong>@TempData["Message"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="row">
        <div class="col-md-6">
            <form method="post" asp-action="Index" class="d-flex">
                <input name="Search" class="form-control me-1" type="search" placeholder="Search" aria-label="Search" />
                <button class="btn btn-primary" type="submit">Search</button>
            </form>
        </div>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>ServiceId</th>
                <th>Image</th>
                <th>Name</th>
                <th>Category</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var service in Model)
            {
                <tr>
                    <td class="align-content-center">@service.Id</td>
                    <td><img src="/SImg/@service.ImageFileName" width="100" /></td>
                    <td class="align-content-center">@service.Name</td>
                    <td class="align-content-center">@service.CategoryName</td>
                    <td style="white-space:nowrap" class="align-content-center">
                        <a class="btn btn-primary btn-sm" asp-controller="Service" asp-action="Edit" asp-route-id="@service.Id">Edit</a>
                        <a class="btn btn-primary btn-sm" style="background-color: #dd4b39;" asp-controller="Service" asp-action="Delete" asp-route-id="@service.Id" onclick="deleteService(@service.Id); return false;">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    function deleteService(serviceId) {
        if (confirm('Are you sure you want to delete this service?')) {
            $.ajax({
                url: '/Service/Delete/' + serviceId,
                type: 'DELETE',
                success: function (result) {
                    window.location.href = '/Service/Index';
                },
                error: function (xhr, status, error) {
                var errorResponse = xhr.responseJSON;
                if (errorResponse && errorResponse.resultCode) {
                    alert('Error deleting book: ' + errorResponse.resultCode);
                } else {
                    alert('Error deleting book');
                }
            }
            });
        }
    }
</script>
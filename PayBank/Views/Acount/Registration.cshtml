@model RegistrationViewModel

@{
    ViewData["Title"] = "Registration";
}


<section class="vh-100" style="background-color: #efefef;">
    <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="card shadow-2-strong" style="border-radius: 1rem;">
                    <div class="card-body p-5 text-center">

                        <h3 class="mb-5">Sign Up</h3>
                        <form role="form" asp-action="Registar" asp-controller="Acount" method="post">
                            <div class="form-outline mb-4">
                                <input asp-for="Name" class="form-control form-control-lg" placeholder="Introduceti UserName-ul">
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="form-outline mb-4">
                                <input type="email" name="Email" asp-for="Email" class="form-control form-control-lg" placeholder="Introduceti Email-ul">
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="form-outline mb-4">
                                <input asp-for="Mobile" autocomplete="off" class="form-control form-control-lg" placeholder="Introduceti Numarul Mobil">
                                <span asp-validation-for="Mobile" class="text-danger"></span>
                            </div>

                            <div class="form-outline mb-4">
                                <input type="password" name="Password" asp-for="Password" autocomplete="off" class="form-control form-control-lg" placeholder="Introduceti Parola">
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="form-outline mb-4">
                                <input type="password" asp-for="ConfirmPassword" autocomplete="off" class="form-control form-control-lg" placeholder="Confirmati Parola">
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>

                            

                            @if (TempData["Message"] != null)
                            {
                                var alertType = TempData["AlertType"]?.ToString() ?? "info";
                                <div class="alert alert-@alertType alert-dismissible fade show" role="alert">
                                    <strong>@TempData["Message"]</strong>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            }
                            <input type="submit" value="Register" class="btn btn-lg btn-primary btn-block px-5">
                            <hr class="my-4">
                            <a class="btn btn-lg btn-block btn-primary" style="background-color: #dd4b39;" asp-controller="Acount" asp-action="Login">Login</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>HR Admin Dashboard</title>
    <link href="images/favicon.png" rel="icon" type="image/x-icon" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/normalize/8.0.1/normalize.min.css">
    <link rel="stylesheet" type="text/css" href="~/css/adminStyle.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
</head>
<body>

    <div id="admin-dashboard-layout">

        <nav id="sidebar">
            <div class="sidebar-header">
                <h3>HR Panel</h3>
            </div>
            <ul class="nav-links">
                <li><a href="/" class="nav-item"><i class="fas fa-home"></i> Home</a></li>
                <li><a id="VacanciesModal-btn" class="nav-item active" data-content="vacancies"><i class="fas fa-briefcase"></i> Vacancies</a></li>
                <li><a id="HiringModal-btn" class="nav-item" data-content="hiring"><i class="fas fa-user-tie"></i> Hiring</a></li>

                <li><a id="CandidatesModal-btn" class="nav-item" data-content="candidats"><i class="fas fa-id-badge"></i> Candidates</a></li>
                <li><a id="EmployeesModal-btn" class="nav-item" data-content="employees"><i class="fas fa-users"></i> Employees</a></li>
                <li><a id="DictionaryModal-btn" class="nav-item" data-content="dictionary"><i class="fas fa-book"></i> Dictionary</a></li>
                <li><a id="UsersModal-btn" class="nav-item" data-content="users"><i class="fas fa-users-cog"></i> Users</a></li>
            </ul>
        </nav>

        <main id="main-content">

            <header id="main-header">
                <h1 class="WelcomeToPanel">Welcome, Admin!</h1>
                <div class="user-actions">
                    <button id="add-item-btn" class="btn btn-primary"><i class="fas fa-plus"></i> Add New</button>
                    <a style="float: right;" id="LogOutModal-btn" class="btn btn-secondary"><i class="fas fa-sign-out-alt"></i> LogOut</a>
                </div>
            </header>

            <section id="content-view">

                <div id="vacancies-view" class="data-view active">
                    <h2>Vacancies Management</h2>
                    <table class="data-table" id="VacanciesTable">
                        <thead></thead>
                        <tbody></tbody>
                    </table>
                    <button class="btn btn-success addVacancies" data-action="add-vacancy">Add Vacancy</button>
                </div>

                <div id="hiring-view" class="data-view hidden">
                    <h2>Hiring Candidates</h2>
                    <table class="data-table" id="HiringTable">
                        <thead></thead>
                        <tbody></tbody>
                    </table>
                </div>

                <div id="candidats-view" class="data-view hidden">
                    <h2>Candidat Records</h2>
                    <table class="data-table" id="CandidatsTable">
                        <thead></thead>
                        <tbody></tbody>
                    </table>
                </div>

                <div id="employees-view" class="data-view hidden">
                    <h2>Employee Records</h2>
                    <table class="data-table" id="EmployeesTable">
                        <thead></thead>
                        <tbody></tbody>
                    </table>
                </div>

                <div id="dictionary-view" class="data-view hidden">
                    <h2>System Dictionary</h2>
                    <table class="data-table" id="DictionaryTable">
                        <thead></thead>
                        <tbody></tbody>
                    </table>
                    <button class="btn btn-success addDictionaries" data-action="add-dictionary">Add Dictionary</button>
                </div>

                <div id="users-view" class="data-view hidden">
                    <h2>User Accounts</h2>
                    <table class="data-table" id="UsersTable">
                        <thead></thead>
                        <tbody></tbody>
                    </table>
                    <button class="btn btn-success addUser" data-action="add-user">Add User</button>
                </div>

            </section>
        </main>

    </div>

    <div id="global-modal-behind" class="modal-behind">
        <div id="global-modal" class="modal-container">
            <div class="modal-header">
                <h3 id="modal-title"></h3>
                <button class="close-modal-btn">&times;</button>
            </div>
            <div class="modal-body" id="modal-content-area">
            </div>
        </div>
    </div>

    <script src="js/HRupdate.js"></script>
    <script>
        // JS/jQuery to handle navigation and modal loading
        $(document).ready(function() {
            // Function to handle tab switching
            $('.nav-item').on('click', function(e) {
                e.preventDefault();
                $('.nav-item').removeClass('active');
                $(this).addClass('active');

                const target = $(this).data('content') + '-view';
                $('.data-view').removeClass('active').addClass('hidden');
                $('#' + target).removeClass('hidden').addClass('active');
            });

            // Set initial active view
            $('#vacancies-view').removeClass('hidden').addClass('active');
        });
    </script>
</body>
</html>